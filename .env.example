DB_DIALECT=mysql
# JWT settings
SECRET_KEY=Z9X0D3_UIypb_7HIyowFKhK8evLKvMZfvz94yrJujQgH2VhcxtEcwmmvBOyzG1w6
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Password settings
PASSWORD_MIN_LENGTH=8

# OTP settings (used for signup/login verification and password reset)
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# Set to true only for local dev/testing without a real SMS/email provider —
# request-otp/forgot-password will echo the OTP back in the response instead
# of actually sending it.
DEBUG_RETURN_OTP=true

# MSG91 OTP Widget (server-side access-token verification for phone
# login/signup — see app/services/msg91_service.py). Required for
# POST /api/auth/verify-msg91-token; leave blank in local dev if you're
# not exercising that endpoint yet. Never exposed to the frontend.
MSG91_AUTHKEY=577097AYXEfH65q6abdef07P1
MSG91_WIDGET_ID=366a61656e46363435383536
MSG91_WIDGET_TOKEN=577097TK9Xsl8qLspO6abdec6bP1


# SMTP (optional — leave blank to use the console/log email backend instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
PUBLIC_BASE_URL=http://32.199.119.31:8000
# the public server — set NOMINATIM_EMAIL so OSM can reach you instead of
# just blocking the server's IP if something misbehaves, or switch to
# GEOCODING_PROVIDER=google with a GOOGLE_MAPS_API_KEY for production.
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=
GEOCODING_USER_AGENT=instagram-style-backend/1.0
GOOGLE_MAPS_API_KEY=
GEOCODING_LANGUAGE=en
# Google AdMob (see app/services/admob_service.py, served by GET /api/ads/config)
# Ads are rendered by the AdMob SDK in the mobile app; the backend only returns
# these IDs per placement/platform and records impression/click analytics.
# ADMOB_ENABLED defaults to false when unset. A placement whose ad-unit ID is
# blank is reported as disabled in the config response.
ADMOB_ENABLED=true
